{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm ci",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lovecrm.org"
        }
      ],
      "destination": "https://freecrm.dev/:path*",
      "permanent": true
    }
  ]
}
