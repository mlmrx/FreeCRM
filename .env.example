# Cloudflare Access values are non-secret Worker variables. The guided installer
# writes them only after it has created or verified an exact-owner Access application.
# FREE_CRM_AUTH_MODE=cloudflare-access
# FREE_CRM_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# FREE_CRM_ACCESS_AUD=
# FREE_CRM_OWNER_EMAIL=you@example.com
# Optional public source link for a fork. It must be an HTTPS github.com owner/repository URL.
NEXT_PUBLIC_FREE_CRM_REPOSITORY_URL=https://github.com/mlmrx/FreeCRM

# Native Next.js on Vercel (all secrets are supplied by the deployer in Vercel,
# never committed). `freecrm.dev` is the canonical origin; lovecrm.org redirects.
# FREE_CRM_AUTH_MODE=authjs
# NEXTAUTH_URL=https://freecrm.dev
# NEXT_PUBLIC_SITE_URL=https://freecrm.dev
# FREE_CRM_OWNER_EMAIL=you@example.com
# AUTH_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# Exact HTTPS endpoint of the user-owned D1 data-plane Worker (`/v1/d1`).
# FREE_CRM_D1_RPC_URL=https://free-crm-d1-rpc.<your-subdomain>.workers.dev/v1/d1
# Base64url-encoded 32-byte HMAC secret shared only with that Worker.
# FREE_CRM_D1_RPC_SECRET=
# Cloudflare Access service-token values for the Access application protecting
# the D1 Worker. Both are secrets supplied only to Vercel; do not commit them.
# FREE_CRM_D1_ACCESS_CLIENT_ID=
# FREE_CRM_D1_ACCESS_CLIENT_SECRET=
# BLOB_READ_WRITE_TOKEN=

# Optional device-only second brain. No API key; cloud runtimes cannot invoke local AI.
# Set these non-secret bindings in .dev.vars or pass Wrangler --var on device.
# FREE_CRM_OLLAMA_URL=http://127.0.0.1:11434
# FREE_CRM_OLLAMA_CHAT_MODEL=gemma3:1b
# FREE_CRM_OLLAMA_EMBED_MODEL=embeddinggemma
# Run the separate Ollama server with OLLAMA_NO_CLOUD=1. See docs/SECOND-BRAIN.md.
