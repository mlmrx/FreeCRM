# Cloudflare Access values are non-secret Worker variables. The guided installer
# writes them only after it has created or verified an exact-owner Access application.
# FREE_CRM_AUTH_MODE=cloudflare-access
# FREE_CRM_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# FREE_CRM_ACCESS_AUD=
# FREE_CRM_OWNER_EMAIL=you@example.com
# Optional public source link for a fork. It must be an HTTPS github.com owner/repository URL.
NEXT_PUBLIC_FREE_CRM_REPOSITORY_URL=https://github.com/mlmrx/FreeCRM
